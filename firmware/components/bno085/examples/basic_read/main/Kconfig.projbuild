menu "BNO085 Application Configuration"

    menu "I2C & GPIO"
        config APP_BNO085_I2C_SDA_GPIO
            int "I2C SDA GPIO"
            default 6
            help
                GPIO pin for I2C SDA (data line).

        config APP_BNO085_I2C_SCL_GPIO
            int "I2C SCL GPIO"
            default 7
            help
                GPIO pin for I2C SCL (clock line).

        config APP_BNO085_I2C_ADDR
            hex "BNO085 I2C Address"
            default 0x4A
            range 0x00 0x7F
            help
                I2C slave address (0x4A when AD0=GND, 0x4B when AD0=VCC).

        config APP_BNO085_I2C_FREQ_HZ
            int "I2C Clock Frequency (Hz)"
            default 400000
            range 100000 1000000
            help
                I2C bus frequency. Standard: 400kHz, Fast: 1MHz.

        config APP_BNO085_INT_GPIO
            int "BNO085 INT (data-ready) GPIO"
            default 5
            help
                GPIO pin for BNO085 H_INTN interrupt.

        config APP_BNO085_RST_GPIO
            int "BNO085 RST (reset) GPIO"
            default 4
            help
                GPIO pin for BNO085 NRST reset.
    endmenu

    menu "Sensors to Enable (Read from Device)"
        menu "Orientation Sensors"
            config APP_BNO085_ENABLE_ROTATION_VECTOR
                bool "Rotation Vector (accel+gyro+mag)"
                default n
                help
                    Full 9-axis rotation vector using accelerometer, gyroscope, and magnetometer.
                    Fusion runs on the BNO085 itself and does not require separately enabling
                    the raw accelerometer/gyroscope/magnetometer sensors below.

            config APP_BNO085_ENABLE_GAME_ROTATION_VECTOR
                bool "Game Rotation Vector (accel+gyro, no mag)"
                default n
                help
                    Rotation vector using accelerometer and gyroscope (no magnetometer).
                    Fusion runs on the BNO085 itself and does not require separately enabling
                    the raw accelerometer/gyroscope sensors below.

            config APP_BNO085_ENABLE_GEOMAGNETIC_ROTATION_VECTOR
                bool "Geomagnetic Rotation Vector (accel+mag, no gyro)"
                default n
                help
                    Rotation vector using accelerometer and magnetometer (no gyroscope).
                    Fusion runs on the BNO085 itself and does not require separately enabling
                    the raw accelerometer/magnetometer sensors below.

            config APP_BNO085_ENABLE_AR_VR_STABILIZED_RV
                bool "AR/VR Stabilized Rotation Vector"
                default y
                help
                    High-precision rotation vector for AR/VR applications.
                    Fusion runs on the BNO085 itself and does not require separately enabling
                    the raw accelerometer/gyroscope/magnetometer sensors below.

            config APP_BNO085_ENABLE_GYRO_INTEGRATED_RV
                bool "Gyro Integrated Rotation Vector (1kHz)"
                default n
                help
                    High-frequency (1kHz) rotation vector from gyroscope integration.
                    Fusion runs on the BNO085 itself and does not require separately enabling
                    the raw gyroscope sensor below.
        endmenu

        menu "Raw IMU Data"
            config APP_BNO085_ENABLE_ACCELEROMETER
                bool "Accelerometer (with gravity)"
                default y
                help
                    Calibrated 3-axis accelerometer in m/s² (includes gravity).
                    Used as foundation for gravity extraction and rotation vectors.

            config APP_BNO085_ENABLE_LINEAR_ACCELERATION
                bool "Linear Acceleration (gravity removed)"
                default y
                help
                    Accelerometer with gravity component removed (m/s²).

            config APP_BNO085_ENABLE_GRAVITY
                bool "Gravity Vector"
                default n
                select APP_BNO085_ENABLE_ACCELEROMETER
                select APP_BNO085_ENABLE_LINEAR_ACCELERATION
                help
                    Extracted gravity vector in m/s² (accel - linear_accel).
                    Auto-enables accelerometer and linear acceleration sensors.

            config APP_BNO085_ENABLE_GYROSCOPE
                bool "Gyroscope (calibrated)"
                default y
                help
                    Calibrated 3-axis gyroscope in rad/s.
                    Required for rotation vectors and angular velocity measurements.

            config APP_BNO085_ENABLE_GYROSCOPE_UNCALIBRATED
                bool "Gyroscope (uncalibrated + bias)"
                default n
                help
                    Raw gyroscope data with bias estimates (rad/s + bias terms).

            config APP_BNO085_ENABLE_MAGNETIC_FIELD
                bool "Magnetic Field (calibrated)"
                default y
                help
                    Calibrated 3-axis magnetometer in µTesla.
                    Used for compass heading and rotation vectors with magnetometer.

            config APP_BNO085_ENABLE_MAGNETIC_FIELD_UNCALIBRATED
                bool "Magnetic Field (uncalibrated + bias)"
                default n
                help
                    Raw magnetometer data with bias estimates (µTesla + bias terms).

            config APP_BNO085_ENABLE_RAW_ACCELEROMETER
                bool "Raw Accelerometer (ADC counts)"
                default n
                help
                    Unprocessed accelerometer ADC counts (no calibration).

            config APP_BNO085_ENABLE_RAW_GYROSCOPE
                bool "Raw Gyroscope (ADC counts)"
                default n
                help
                    Unprocessed gyroscope ADC counts (no calibration).

            config APP_BNO085_ENABLE_RAW_MAGNETOMETER
                bool "Raw Magnetometer (ADC counts)"
                default n
                help
                    Unprocessed magnetometer ADC counts (no calibration).
        endmenu

        menu "Environmental Sensors"
            config APP_BNO085_ENABLE_PRESSURE
                bool "Pressure (Pa)"
                default n
                help
                    Barometric pressure sensor (if equipped). Not all BNO085 variants support this.

            config APP_BNO085_ENABLE_HUMIDITY
                bool "Humidity (%)"
                default n
                help
                    Relative humidity sensor (if equipped). Not all BNO085 variants support this.

            config APP_BNO085_ENABLE_TEMPERATURE
                bool "Temperature (°C)"
                default n
                help
                    Temperature sensor (if equipped). Not all BNO085 variants support this.

            config APP_BNO085_ENABLE_AMBIENT_LIGHT
                bool "Ambient Light (lux)"
                default n
                help
                    Light sensor (if equipped). Not all BNO085 variants support this.
        endmenu

        menu "Activity & Motion Detection"
            config APP_BNO085_ENABLE_STEP_COUNTER
                bool "Step Counter"
                default n
                help
                    Cumulative step count since sensor reset.

            config APP_BNO085_ENABLE_STEP_DETECTOR
                bool "Step Detector (event)"
                default n
                help
                    Event trigger on each step detected.

            config APP_BNO085_ENABLE_STABILITY_CLASSIFIER
                bool "Stability Classifier"
                default n
                help
                    Classifies device stability: unknown, on-table, stationary, stable, or motion.

            config APP_BNO085_ENABLE_PERSONAL_ACTIVITY_CLASSIFIER
                bool "Personal Activity Classifier"
                default n
                help
                    Classifies activity: still, walking, running, cycling, in-vehicle, etc.

            config APP_BNO085_ENABLE_SIGNIFICANT_MOTION
                bool "Significant Motion Detector"
                default n
                help
                    Triggers when significant motion is detected.

            config APP_BNO085_ENABLE_SHAKE_DETECTOR
                bool "Shake Detector"
                default n
                help
                    Detects high-frequency shaking motion.

            config APP_BNO085_ENABLE_TAP_DETECTOR
                bool "Tap Detector (single/double)"
                default n
                help
                    Detects and classifies tap events (single or double tap) with direction.

            config APP_BNO085_ENABLE_FLIP_DETECTOR
                bool "Flip Detector"
                default n
                help
                    Detects when device is flipped.

            config APP_BNO085_ENABLE_PICKUP_DETECTOR
                bool "Pickup Detector"
                default n
                help
                    Detects when device is picked up from a surface.

            config APP_BNO085_ENABLE_TILT_DETECTOR
                bool "Tilt Detector"
                default n
                help
                    Detects change in device tilt angle.

            config APP_BNO085_ENABLE_POCKET_DETECTOR
                bool "Pocket Detector"
                default n
                help
                    Detects if device is in a pocket (no light, pressure on sensors).

            config APP_BNO085_ENABLE_CIRCLE_DETECTOR
                bool "Circle Detector"
                default n
                help
                    Detects circular motion patterns.

            config APP_BNO085_ENABLE_SLEEP_DETECTOR
                bool "Sleep Detector"
                default n
                help
                    Detects sleep state (requires extended monitoring).
        endmenu
    endmenu

    menu "Sensors to Print (CSV Output)"
        menu "Orientation Sensors"
            config APP_BNO085_PRINT_ROTATION_VECTOR
                bool "Rotation Vector"
                depends on APP_BNO085_ENABLE_ROTATION_VECTOR
                default n
                help
                    Print rotation vector data in CSV output.

            config APP_BNO085_PRINT_GAME_ROTATION_VECTOR
                bool "Game Rotation Vector"
                depends on APP_BNO085_ENABLE_GAME_ROTATION_VECTOR
                default n
                help
                    Print game rotation vector data in CSV output.

            config APP_BNO085_PRINT_GEOMAGNETIC_ROTATION_VECTOR
                bool "Geomagnetic Rotation Vector"
                depends on APP_BNO085_ENABLE_GEOMAGNETIC_ROTATION_VECTOR
                default n
                help
                    Print geomagnetic rotation vector data in CSV output.

            config APP_BNO085_PRINT_AR_VR_STABILIZED_RV
                bool "AR/VR Stabilized Rotation Vector"
                depends on APP_BNO085_ENABLE_AR_VR_STABILIZED_RV
                default y
                help
                    Print AR/VR stabilized rotation vector data in CSV output.

            config APP_BNO085_PRINT_GYRO_INTEGRATED_RV
                bool "Gyro Integrated Rotation Vector"
                depends on APP_BNO085_ENABLE_GYRO_INTEGRATED_RV
                default n
                help
                    Print gyro integrated rotation vector data in CSV output.
        endmenu

        menu "Raw IMU Data"
            config APP_BNO085_PRINT_ACCELEROMETER
                bool "Accelerometer"
                depends on APP_BNO085_ENABLE_ACCELEROMETER
                default n
                help
                    Print accelerometer data in CSV output.

            config APP_BNO085_PRINT_LINEAR_ACCELERATION
                bool "Linear Acceleration"
                depends on APP_BNO085_ENABLE_LINEAR_ACCELERATION
                default n
                help
                    Print linear acceleration data in CSV output.

            config APP_BNO085_PRINT_GRAVITY
                bool "Gravity Vector"
                depends on APP_BNO085_ENABLE_GRAVITY
                default n
                help
                    Print gravity vector data in CSV output.

            config APP_BNO085_PRINT_GYROSCOPE
                bool "Gyroscope (calibrated)"
                depends on APP_BNO085_ENABLE_GYROSCOPE
                default n
                help
                    Print calibrated gyroscope data in CSV output.

            config APP_BNO085_PRINT_GYROSCOPE_UNCALIBRATED
                bool "Gyroscope (uncalibrated + bias)"
                depends on APP_BNO085_ENABLE_GYROSCOPE_UNCALIBRATED
                default n
                help
                    Print uncalibrated gyroscope data with bias in CSV output.

            config APP_BNO085_PRINT_MAGNETIC_FIELD
                bool "Magnetic Field (calibrated)"
                depends on APP_BNO085_ENABLE_MAGNETIC_FIELD
                default n
                help
                    Print calibrated magnetometer data in CSV output.

            config APP_BNO085_PRINT_MAGNETIC_FIELD_UNCALIBRATED
                bool "Magnetic Field (uncalibrated + bias)"
                depends on APP_BNO085_ENABLE_MAGNETIC_FIELD_UNCALIBRATED
                default n
                help
                    Print uncalibrated magnetometer data with bias in CSV output.

            config APP_BNO085_PRINT_RAW_ACCELEROMETER
                bool "Raw Accelerometer (ADC counts)"
                depends on APP_BNO085_ENABLE_RAW_ACCELEROMETER
                default n
                help
                    Print raw accelerometer ADC counts in CSV output.

            config APP_BNO085_PRINT_RAW_GYROSCOPE
                bool "Raw Gyroscope (ADC counts)"
                depends on APP_BNO085_ENABLE_RAW_GYROSCOPE
                default n
                help
                    Print raw gyroscope ADC counts in CSV output.

            config APP_BNO085_PRINT_RAW_MAGNETOMETER
                bool "Raw Magnetometer (ADC counts)"
                depends on APP_BNO085_ENABLE_RAW_MAGNETOMETER
                default n
                help
                    Print raw magnetometer ADC counts in CSV output.
        endmenu

        menu "Environmental Sensors"
            config APP_BNO085_PRINT_PRESSURE
                bool "Pressure"
                depends on APP_BNO085_ENABLE_PRESSURE
                default n
                help
                    Print pressure data in CSV output.

            config APP_BNO085_PRINT_HUMIDITY
                bool "Humidity"
                depends on APP_BNO085_ENABLE_HUMIDITY
                default n
                help
                    Print humidity data in CSV output.

            config APP_BNO085_PRINT_TEMPERATURE
                bool "Temperature"
                depends on APP_BNO085_ENABLE_TEMPERATURE
                default n
                help
                    Print temperature data in CSV output.

            config APP_BNO085_PRINT_AMBIENT_LIGHT
                bool "Ambient Light"
                depends on APP_BNO085_ENABLE_AMBIENT_LIGHT
                default n
                help
                    Print ambient light data in CSV output.
        endmenu

        menu "Activity & Motion Detection"
            config APP_BNO085_PRINT_STEP_COUNTER
                bool "Step Counter"
                depends on APP_BNO085_ENABLE_STEP_COUNTER
                default n
                help
                    Print step counter data in CSV output.

            config APP_BNO085_PRINT_STEP_DETECTOR
                bool "Step Detector"
                depends on APP_BNO085_ENABLE_STEP_DETECTOR
                default n
                help
                    Print step detector events in CSV output.

            config APP_BNO085_PRINT_STABILITY_CLASSIFIER
                bool "Stability Classifier"
                depends on APP_BNO085_ENABLE_STABILITY_CLASSIFIER
                default n
                help
                    Print stability classification in CSV output.

            config APP_BNO085_PRINT_PERSONAL_ACTIVITY_CLASSIFIER
                bool "Personal Activity Classifier"
                depends on APP_BNO085_ENABLE_PERSONAL_ACTIVITY_CLASSIFIER
                default n
                help
                    Print activity classification in CSV output.

            config APP_BNO085_PRINT_SIGNIFICANT_MOTION
                bool "Significant Motion"
                depends on APP_BNO085_ENABLE_SIGNIFICANT_MOTION
                default n
                help
                    Print significant motion detector events in CSV output.

            config APP_BNO085_PRINT_SHAKE_DETECTOR
                bool "Shake Detector"
                depends on APP_BNO085_ENABLE_SHAKE_DETECTOR
                default n
                help
                    Print shake detector events in CSV output.

            config APP_BNO085_PRINT_TAP_DETECTOR
                bool "Tap Detector"
                depends on APP_BNO085_ENABLE_TAP_DETECTOR
                default n
                help
                    Print tap detector events in CSV output.

            config APP_BNO085_PRINT_FLIP_DETECTOR
                bool "Flip Detector"
                depends on APP_BNO085_ENABLE_FLIP_DETECTOR
                default n
                help
                    Print flip detector events in CSV output.

            config APP_BNO085_PRINT_PICKUP_DETECTOR
                bool "Pickup Detector"
                depends on APP_BNO085_ENABLE_PICKUP_DETECTOR
                default n
                help
                    Print pickup detector events in CSV output.

            config APP_BNO085_PRINT_TILT_DETECTOR
                bool "Tilt Detector"
                depends on APP_BNO085_ENABLE_TILT_DETECTOR
                default n
                help
                    Print tilt detector events in CSV output.

            config APP_BNO085_PRINT_POCKET_DETECTOR
                bool "Pocket Detector"
                depends on APP_BNO085_ENABLE_POCKET_DETECTOR
                default n
                help
                    Print pocket detector events in CSV output.

            config APP_BNO085_PRINT_CIRCLE_DETECTOR
                bool "Circle Detector"
                depends on APP_BNO085_ENABLE_CIRCLE_DETECTOR
                default n
                help
                    Print circle detector events in CSV output.

            config APP_BNO085_PRINT_SLEEP_DETECTOR
                bool "Sleep Detector"
                depends on APP_BNO085_ENABLE_SLEEP_DETECTOR
                default n
                help
                    Print sleep detector events in CSV output.
        endmenu
    endmenu


    menu "Output Format"
        config APP_BNO085_OUTPUT_CSV
            bool "CSV Output Enabled"
            default y
            help
                Enable CSV (comma-separated values) output format.

        config APP_BNO085_SENSOR_UPDATE_PERIOD_MS
            int "Sensor Update Period (ms)"
            default 10
            range 5 1000
            help
                How frequently to poll the BNO085 for new sensor data.
                Lower values = more responsive, higher CPU usage.
                Higher values = less responsive, lower CPU usage.
                (This is the polling interval of the service task, not individual sensor rates)
                Output Period below is floored to this value, since printing faster than
                the sensor refreshes would just repeat the same cached reading.

        config APP_BNO085_OUTPUT_PERIOD_MS
            int "Output Period (ms)"
            depends on APP_BNO085_OUTPUT_CSV
            default 100
            range APP_BNO085_SENSOR_UPDATE_PERIOD_MS 10000
            help
                Frequency of data output in CSV mode (timer-based print task).
                Minimum is clamped to Sensor Update Period above, since a faster
                output rate would just print duplicate cached rows.

        choice APP_BNO085_ROTATION_VECTOR_FORMAT
            prompt "Rotation Vector Output Format (applies to all rotation vectors)"
            default APP_BNO085_RV_FORMAT_EULER
            help
                Choose output format for all rotation vector sensors.
                This setting applies globally to all rotation vector types.

            config APP_BNO085_RV_FORMAT_QUATERNION
                bool "Quaternion (i, j, k, real, accuracy)"
                help
                    Output as quaternion components (i, j, k) and real part.
                    Quaternion represents rotation as q = i*x + j*y + k*z + real.
                    Applied to: Rotation Vector, Game RV, Geomagnetic RV, AR/VR RV, Gyro Integrated RV.

            config APP_BNO085_RV_FORMAT_EULER
                bool "Euler Angles (roll, pitch, yaw in degrees)"
                help
                    Output as Euler angles in degrees (roll, pitch, yaw) with accuracy.
                    Roll: rotation around X axis (-180° to +180°)
                    Pitch: rotation around Y axis (-90° to +90°)
                    Yaw: rotation around Z axis (-180° to +180°)
                    Applied to: Rotation Vector, Game RV, Geomagnetic RV, AR/VR RV, Gyro Integrated RV.
        endchoice

        choice APP_BNO085_TIMESTAMP_PRINT_MODE
            prompt "Timestamp Column in CSV"
            depends on APP_BNO085_OUTPUT_CSV
            default APP_BNO085_TIMESTAMP_PRINT_MODE_DISABLED
            help
                Whether to print sensor timestamp in CSV output.

            config APP_BNO085_TIMESTAMP_PRINT_MODE_DISABLED
                bool "None (no timestamp)"
                help
                    Do not print any timestamps.

            config APP_BNO085_TIMESTAMP_PRINT_MODE_SENSOR
                bool "Sensor Timestamp Only"
                help
                    Print timestamp of when data was read from sensor.
        endchoice

        config APP_BNO085_CSV_PRINT_HEADER
            bool "Print CSV Header"
            depends on APP_BNO085_OUTPUT_CSV
            default y
            help
                Print column names as first line.

        choice APP_BNO085_CSV_SEPARATOR
            prompt "CSV Separator Character"
            depends on APP_BNO085_OUTPUT_CSV
            default APP_BNO085_CSV_SEPARATOR_COMMA
            help
                Character used to separate values in CSV output.

            config APP_BNO085_CSV_SEPARATOR_COMMA
                bool "Comma (,)"

            config APP_BNO085_CSV_SEPARATOR_SEMICOLON
                bool "Semicolon (;)"

            config APP_BNO085_CSV_SEPARATOR_PIPE
                bool "Pipe (|)"

            config APP_BNO085_CSV_SEPARATOR_TAB
                bool "Tab (\\t)"
        endchoice

        config APP_BNO085_CSV_SPACE_AFTER_SEPARATOR
            bool "Add Space After Separator"
            depends on APP_BNO085_OUTPUT_CSV
            default y
            help
                Add a space after each separator (e.g., ", " instead of ",").
    endmenu

endmenu
